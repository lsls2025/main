DEBUG_PANEL_WIDTH = 280
DEBUG_PANEL_HEIGHT = 400
DEBUG_PANEL_X = 10
DEBUG_PANEL_Y = 10
DEBUG_ROW_HEIGHT = 26
DEBUG_LABEL_WIDTH = 80
DEBUG_BUTTON_WIDTH = 30
